# Line endings matter for the launchers.
#
# run.sh MUST stay LF: a CRLF shebang makes bash fail with
# "bad interpreter: /usr/bin/env bash^M" on macOS and Linux.
# run.bat MUST be CRLF: cmd.exe mishandles LF-only batch files.

* text=auto

*.sh   text eol=lf
*.bat  text eol=crlf
*.cmd  text eol=crlf

*.py   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.html text eol=lf

# Captured Amazon markup - keep byte-identical so the parser tests stay honest.
tests/fixtures/* -text linguist-vendored
